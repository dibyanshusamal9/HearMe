# Server-only credentials. Copy to .env in the repository root.
SARVAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SARVAM_STT_MODEL=saaras:v4
HEARME_API_TIMEOUT_MS=12000
PORT=8080
HTTPS_PORT=8443
# Public deployment: terminate trusted HTTPS at your reverse proxy.
# HEARME_HOST=your-domain.example
# HEARME_TLS_CERT=/path/to/fullchain.pem
# HEARME_TLS_KEY=/path/to/privkey.pem
